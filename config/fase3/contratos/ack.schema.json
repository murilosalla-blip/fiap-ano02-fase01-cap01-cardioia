{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CardioIA confirmacao de persistencia v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device_id", "session_id", "sequence", "status"],
  "properties": {
    "schema_version": { "const": 1 },
    "device_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$" },
    "session_id": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "status": { "const": "stored" }
  }
}
